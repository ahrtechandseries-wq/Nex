# Optional. TheSportsDB free-tier API key. If unset, the
# /api/sports route falls back to TheSportsDB's public "3" test
# key, which is fine for development but shares its rate limit
# with everyone else using the same default - set your own free
# key here for production.
#
# Get one at https://www.thesportsdb.com/free_api.php
SPORTS_API_KEY=
